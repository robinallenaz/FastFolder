
{
  "manifest_version": 3,
  "name": "FastFolder",
  "description": "Access a chosen bookmarks folder instantly from your toolbar popup.",
  "version": "1.1.0",
  "permissions": ["bookmarks", "storage", "tabs"],
  "action": {
    "default_title": "FastFolder",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
